pipeline {
    agent {
        docker {
            image 'openjdk:11-jdk'
            args '-v $HOME/.m2:/root/.m2'
        }
    }
    
    environment {
        APP_ENV = 'development'  // Can be changed to 'production'
        APP_VERSION = '1.0.0'
    }
    
    stages {
        stage('Environment Check') {
            steps {
                script {
                    if (env.APP_ENV == 'production') {
                        echo "This is a PRODUCTION build (Version: ${env.APP_VERSION})"
                    } else {
                        echo "This is a DEVELOPMENT build (Version: ${env.APP_VERSION})"
                    }
                }
            }
        }
        
        stage('Parallel Compilation') {
            parallel {
                stage('Compile Task 1') {
                    steps {
                        sh 'javac Task1.java'
                    }
                }
                stage('Compile Task 2') {
                    steps {
                        sh 'javac Task2.java'
                    }
                }
            }
        }
        
        stage('Archive Compiled Files') {
            steps {
                archiveArtifacts artifacts: '*.class', fingerprint: true
            }
        }
    }
    
    post {
        success {
            cleanWs()
            echo "Workspace cleaned successfully"
        }
    }
}